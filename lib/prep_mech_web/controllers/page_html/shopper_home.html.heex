<div>
  <h1 class="text-xl font-semibold tracking-tight">Dashboard</h1>
  <p class="mt-1 text-sm text-ui-text-2">
    Claim orders from the pool and drive them to delivery.
  </p>
</div>

<%!-- dashboard summary tiles --%>
<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
  <div
    :for={{status, label} <- status_tiles()}
    class="rounded-lg border border-ui-line bg-ui-surface p-4"
  >
    <p class={["text-2xl font-semibold tabular-nums", tile_color(status)]}>{@summary[status]}</p>
    <p class="mt-0.5 text-xs text-ui-text-2">{label}</p>
  </div>
</div>

<%!-- open pool --%>
<div class="mt-10 flex items-center justify-between">
  <h2 class="text-base font-semibold">Available orders</h2>
  <span class="text-xs text-ui-text-3">Realtime · claim before someone else</span>
</div>

<p
  :if={@pool == []}
  id="pool-empty"
  class="mt-4 rounded-lg border border-ui-line bg-ui-surface px-6 py-10 text-center text-sm text-ui-text-2"
>
  No orders waiting right now.
</p>

<ul id="pool-list" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
  <li
    :for={order <- @pool}
    id={"pool-order-#{order.id}"}
    class="pool-card flex h-full flex-col rounded-lg border border-ui-line bg-ui-surface p-4"
    data-order-id={order.id}
    data-summary={item_summary(order.line_items)}
    data-count={length(order.line_items)}
    data-address={order.delivery_address}
  >
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2">
        <p class="text-sm font-semibold">Order #{order.id}</p>
        <span
          :if={recent?(order.inserted_at, 10)}
          class="rounded bg-st-blue/10 px-1.5 py-0.5 text-[10px] font-medium text-st-blue"
        >
          New
        </span>
      </div>
      <span class="text-xs text-ui-text-3">{length(order.line_items)} items</span>
    </div>

    <button
      type="button"
      class="pool-view mt-2 text-left text-xs text-ui-text-2 hover:text-ui-text"
    >
      {item_summary(order.line_items)}
    </button>

    <p class="mt-2 flex items-center gap-1 truncate text-xs text-ui-text-3">
      <span aria-hidden="true">&#128205;</span>
      <span class="truncate">{order.delivery_address}</span>
    </p>
    <p class="mt-1 text-[11px] text-ui-text-3">placed {time_ago(order.inserted_at)}</p>

    <.form for={%{}} action={~p"/jobs/#{order}/claim"} class="pool-accept mt-3 flex-none">
      <button type="submit" class="ui-btn w-full">Accept</button>
    </.form>
  </li>
</ul>

<%!-- quick-pickup modal (progressive enhancement; the inline Accept works without it) --%>
<div
  id="pool-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pool-modal-title"
  hidden
>
  <div class="w-full max-w-md rounded-lg border border-ui-line bg-ui-surface p-5">
    <div class="flex items-center justify-between gap-4">
      <h3 id="pool-modal-title" class="text-base font-semibold">
        Order <span id="pool-modal-id"></span>
      </h3>
      <button
        type="button"
        id="pool-modal-close"
        class="grid h-9 w-9 place-items-center rounded-md text-ui-text-3 hover:text-ui-text"
        aria-label="Close"
      >
        &times;
      </button>
    </div>
    <p id="pool-modal-summary" class="mt-2 text-sm text-ui-text-2"></p>
    <p id="pool-modal-location" class="mt-1 flex items-start gap-1 text-xs text-ui-text-3">
      <span aria-hidden="true">&#128205;</span>
      <span id="pool-modal-location-text"></span>
    </p>
    <p id="pool-modal-count" class="mt-1 text-xs text-ui-text-3"></p>
    <form id="pool-modal-form" method="post" class="mt-4">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <button type="submit" class="ui-btn w-full">Accept order</button>
    </form>
  </div>
</div>

<%!-- my jobs --%>
<h2 class="mt-10 text-base font-semibold">My jobs</h2>

<p :if={@jobs == []} class="mt-4 text-sm text-ui-text-2">You haven't claimed any orders yet.</p>

<ul :if={@jobs != []} class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
  <li :for={job <- @jobs}>
    <.link
      navigate={~p"/jobs/#{job}"}
      class="flex h-full flex-col rounded-lg border border-ui-line bg-ui-surface p-4 transition-colors hover:border-ui-text-3 hover:bg-ui-surface-2"
    >
      <div class="flex items-start justify-between gap-3">
        <p class="text-sm font-semibold">Order #{job.id}</p>
        <.status_chip status={job.status} />
      </div>
      <p class="mt-2 text-xs text-ui-text-3">{length(job.line_items)} items</p>
    </.link>
  </li>
</ul>

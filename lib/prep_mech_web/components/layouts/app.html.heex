<% user = assigns[:current_user] %>
<div class="min-h-screen bg-ui-canvas font-sans text-ui-text antialiased">
  <header class="border-b border-ui-line-soft">
    <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
      <.link navigate={~p"/"} class="font-pixel text-lg tracking-wide text-st-amber">
        PREPMECH
      </.link>
      <nav class="flex items-center gap-4 text-sm text-ui-text-2 sm:gap-5">
        <.link navigate={~p"/"} class="hover:text-ui-text">Orders</.link>
        <%= if user do %>
          <.link href={~p"/logout"} method="delete" class="hover:text-ui-text">Log out</.link>
          <span
            class="grid h-7 w-7 place-items-center rounded-full border border-ui-line bg-ui-surface-2 text-xs font-medium text-ui-text"
            title={user.name}
          >
            {String.first(user.name)}
          </span>
        <% end %>
      </nav>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
